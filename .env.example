# bot-relay configuration (pure registry, design §12.2).
# Copy to .env and replace the secrets:
#   openssl rand -hex 32    # ADMIN_TOKEN
#   openssl rand -hex 32    # ENCRYPTION_KEY

# The process listens on loopback only. The public entry is the local
# cloudflared (Cloudflare Tunnel) client hitting 127.0.0.1:8080 — never a
# directly opened port (design §12.1, decision D1).
HOST=127.0.0.1
PORT=8080

DATABASE_PATH=./data/bot-relay.sqlite

# Required. Deployer credential for the admin console (/admin) and the
# programmatic admin API (Authorization: Bearer <ADMIN_TOKEN>).
ADMIN_TOKEN=replace-with-a-long-random-string

# Required. AES-256-GCM key for stored webhook URLs, webhook secrets, and the
# registry Ed25519 private key. Losing it makes all encrypted data (contact
# details, signing key) permanently unrecoverable — back it up with the data
# directory. Rotating it means bots must re-register their webhook secrets.
ENCRYPTION_KEY=replace-with-another-long-random-string

# Required. Public origin of this registry: used as the identity token `iss`
# and to build invite registration links.
PUBLIC_BASE_URL=https://relay.songyang.xyz

# Comma-separated IPs/CIDRs whose CF-Connecting-IP header is trusted. The
# default trusts only the local tunnel client; requests from any other peer
# are identified by their socket address and spoofed proxy headers are ignored.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Admin browser session lifetime in seconds (default 12 hours).
ADMIN_SESSION_TTL_SEC=43200

# Allow http:// and private-network webhook URLs. Local testing only — leave
# false on any real deployment.
ALLOW_HTTP_WEBHOOKS=false
ALLOW_PRIVATE_WEBHOOKS=false

# Shared rate-limit window in seconds.
RATE_LIMIT_WINDOW_SEC=60

# Authorization inquiry lifetime (default 24h) and the outbound delivery
# timeout (single attempt, no retry).
INQUIRY_TTL_SEC=86400
INQUIRY_DELIVERY_TIMEOUT_MS=10000

# Identity proof JWT lifetime; capped at 300 seconds (design §7.2).
IDENTITY_TOKEN_TTL_SEC=300

# Rate limit overrides.
REGISTER_RATE_PER_MIN=10
LOGIN_RATE_PER_MIN=10
INQUIRY_RATE_PER_MIN=10
INQUIRY_PAIR_RATE_PER_HOUR=5
MUTATION_RATE_PER_MIN=30
DEFAULT_RATE_PER_MIN=60
