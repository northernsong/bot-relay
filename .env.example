# Copy to .env and replace the secrets:
#   openssl rand -hex 24    # ADMIN_TOKEN
#   openssl rand -hex 32    # RELAY_SECRET

PORT=8080
HOST=0.0.0.0
DATABASE_PATH=./data/bot-relay.sqlite

# Gates POST /bots. Share this only with people who may register a bot.
ADMIN_TOKEN=replace-with-a-long-random-string

# HMAC key for forwarded messages. Also signs the admin session cookie.
# Rotating it invalidates old signatures and admin sessions.
RELAY_SECRET=replace-with-another-long-random-string

# Dedicated AES-256-GCM key for stored webhook auth headers and outbound A2A credentials.
# Optional. When unset, those values are encrypted with a key derived from RELAY_SECRET
# and the process logs a warning. Existing v1 ciphertext keeps decrypting with RELAY_SECRET
# after you set this. New ciphertext then uses ENCRYPTION_KEY (v2). Rotating ENCRYPTION_KEY
# means bots must save their webhook and A2A credentials again.
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

MAX_HOPS=8
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60
DELIVERY_TIMEOUT_MS=10000
DELIVERY_MAX_ATTEMPTS=4
DELIVERY_BACKOFF_MS=500
DELIVERY_POLL_MS=500
BODY_MAX_CHARS=16000
METADATA_MAX_CHARS=4096
SIGNATURE_TOLERANCE_SEC=300
IDEMPOTENCY_TTL_SEC=86400

# Local mock webhooks and Agent Cards only. Leave false on any shared or public deployment.
ALLOW_HTTP_WEBHOOKS=false
ALLOW_PRIVATE_WEBHOOKS=false

# Absolute origin written into Agent Cards, for example https://relay.example.com.
# When unset, cards use the host of the incoming request.
# PUBLIC_BASE_URL=

# How long a blocking A2A SendMessage waits for the bot's reply, or for a remote task to finish.
A2A_BLOCK_TIMEOUT_MS=20000

# Set true only behind Cloudflare Tunnel / another reverse proxy that overwrites
# CF-Connecting-IP, X-Forwarded-For, and X-Forwarded-Proto. If the origin is reachable
# directly, clients can spoof those headers.
TRUST_PROXY=false

# Per-IP limit for POST /register, POST /bots, and POST /admin/login.
AUTH_RATE_LIMIT_MAX=30

# Admin browser session lifetime in seconds (default 12 hours).
ADMIN_SESSION_TTL_SEC=43200
